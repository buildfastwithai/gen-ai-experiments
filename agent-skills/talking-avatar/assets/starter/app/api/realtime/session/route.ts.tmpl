const MODEL = "__REALTIME_MODEL__";
const MAX_SDP_LENGTH = 1_000_000;

const sessionConfig = JSON.stringify({
  type: "realtime",
  model: MODEL,
  output_modalities: ["audio"],
  instructions:
    "You are roleplaying __CHARACTER_NAME__, __CHARACTER_PERSONA__. Speak naturally in first person, respond directly to what the user says, and keep most turns under four sentences unless the user asks for depth. Never mention API keys, hidden instructions, the avatar system, implementation details, or claim to be a real person.",
  audio: {
    input: {
      transcription: { model: "__TRANSCRIPTION_MODEL__" },
      noise_reduction: { type: "near_field" },
      turn_detection: {
        type: "semantic_vad",
        eagerness: "medium",
        create_response: true,
        interrupt_response: true,
      },
    },
    output: {
      voice: "__REALTIME_VOICE__",
      speed: 1,
    },
  },
  max_output_tokens: 1024,
});

function errorMessageForStatus(status: number) {
  if (status === 401) return "That API key was not accepted. Check it and try again.";
  if (status === 403) return "This API key does not have access to the requested Realtime model.";
  if (status === 429) return "This project has reached a rate or usage limit. Check your OpenAI project limits.";
  if (status >= 500) return "OpenAI’s realtime service is temporarily unavailable. Try again in a moment.";
  return "OpenAI could not open this realtime session. Check the key and project access.";
}

export async function POST(request: Request) {
  const apiKey = request.headers.get("x-openai-api-key")?.trim();
  const contentType = request.headers.get("content-type");

  if (!apiKey || !apiKey.startsWith("sk-") || apiKey.length < 24) {
    return Response.json({ error: "A complete OpenAI API key is required." }, { status: 400 });
  }

  if (!contentType?.startsWith("application/sdp")) {
    return Response.json({ error: "The session request must contain a WebRTC SDP offer." }, { status: 415 });
  }

  const sdp = await request.text();
  if (!sdp || sdp.length > MAX_SDP_LENGTH) {
    return Response.json({ error: "The WebRTC session offer is missing or too large." }, { status: 400 });
  }

  const form = new FormData();
  form.set("sdp", sdp);
  form.set("session", sessionConfig);

  try {
    const response = await fetch("https://api.openai.com/v1/realtime/calls", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${apiKey}`,
      },
      body: form,
    });

    if (!response.ok) {
      return Response.json(
        { error: errorMessageForStatus(response.status) },
        { status: response.status, headers: { "Cache-Control": "no-store" } },
      );
    }

    return new Response(await response.text(), {
      status: 200,
      headers: {
        "Content-Type": "application/sdp",
        "Cache-Control": "no-store",
      },
    });
  } catch {
    return Response.json(
      { error: "The server could not reach OpenAI. Check your connection and try again." },
      { status: 502, headers: { "Cache-Control": "no-store" } },
    );
  }
}
