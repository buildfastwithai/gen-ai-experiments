@import "tailwindcss";

:root {
  --ink: #171713;
  --paper: #f0ede3;
  --muted: #88877e;
  --line: rgba(240, 237, 227, 0.13);
  --accent: #d8693e;
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

* { box-sizing: border-box; }
html, body { min-height: 100%; background: var(--ink); }
body { margin: 0; color: var(--paper); font-family: var(--font-sans), sans-serif; }
button, input { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button:focus-visible, input:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
img { display: block; max-width: 100%; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.gate-shell, .room-shell { min-height: 100dvh; overflow: hidden; }
.gate-shell, .room-shell { position: relative; display: grid; grid-template-rows: auto 1fr; background: radial-gradient(circle at 76% 45%, rgba(216,105,62,.12), transparent 27%), var(--ink); }
.gate-shell::after, .room-shell::after { position: fixed; inset: 0; pointer-events: none; content: ""; opacity: .16; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; }
.gate-grid { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.034) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.034) 1px,transparent 1px); background-size: 46px 46px; mask-image: linear-gradient(to right,black,transparent 84%); }
.gate-nav, .room-nav { position: relative; z-index: 4; display: grid; grid-template-columns: 1fr auto; align-items: center; width: min(100% - 64px,1480px); margin: 0 auto; padding: 26px 0 21px; border-bottom: 1px solid var(--line); }
.room-nav { grid-template-columns: 1fr auto 1fr; }
.wordmark { width: max-content; color: var(--paper); font-size: 17px; font-weight: 720; letter-spacing: -.045em; text-decoration: none; }
.wordmark span { margin-left: 4px; color: var(--accent); font-family: var(--font-mono),monospace; font-size: 9px; font-weight: 600; letter-spacing: .08em; vertical-align: 2px; }
.model-stamp, .room-model { display: flex; align-items: center; gap: 9px; color: rgba(240,237,227,.48); font-family: var(--font-mono),monospace; font-size: 9px; letter-spacing: .11em; text-transform: uppercase; }
.status-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(216,105,62,.12); animation: status-breathe 2.2s ease-in-out infinite; }
.gate-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,.92fr) minmax(450px,1.08fr); align-items: center; width: min(100% - 64px,1480px); min-height: calc(100dvh - 80px); margin: 0 auto; padding: 48px 0 62px; }
.gate-copy { width: min(100%,600px); padding-left: clamp(0px,5vw,76px); }
.eyebrow { margin: 0 0 25px; color: var(--accent); font-family: var(--font-mono),monospace; font-size: 9px; font-weight: 650; letter-spacing: .16em; }
.gate-copy h1 { margin: 0; font-size: clamp(46px,5vw,76px); font-weight: 510; letter-spacing: -.067em; line-height: .96; }
.gate-copy h1 span { color: rgba(240,237,227,.34); }
.gate-intro { max-width: 52ch; margin: 29px 0 0; color: rgba(240,237,227,.55); font-size: 14px; line-height: 1.68; }
.key-form { width: min(100%,500px); margin-top: 38px; }
.key-form > label { display: block; margin-bottom: 10px; color: rgba(240,237,227,.7); font-family: var(--font-mono),monospace; font-size: 9px; letter-spacing: .11em; text-transform: uppercase; }
.key-input-wrap { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; height: 58px; padding: 0 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.05); box-shadow: inset 0 1px 0 rgba(255,255,255,.08); transition: border-color 280ms cubic-bezier(.16,1,.3,1),background 280ms cubic-bezier(.16,1,.3,1); }
.key-input-wrap:focus-within { border-color: rgba(255,255,255,.42); background: rgba(255,255,255,.075); }
.key-input-wrap--ready, .key-input-wrap--error { border-color: rgba(216,105,62,.7); }
.key-input-wrap--error { animation: input-nudge 360ms cubic-bezier(.36,.07,.19,.97); }
.key-input-wrap svg { color: rgba(240,237,227,.52); }
.key-input-wrap input { min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; color: var(--paper); font-family: var(--font-mono),monospace; font-size: 13px; }
.key-input-wrap input::placeholder { color: rgba(240,237,227,.22); }
.key-progress { position: absolute; right: 0; bottom: 0; left: 0; height: 2px; transform-origin: left; background: var(--accent); transition: transform 280ms cubic-bezier(.16,1,.3,1); }
.reveal-button { display: grid; width: 36px; height: 36px; padding: 0; border: 0; place-items: center; background: transparent; color: rgba(240,237,227,.5); cursor: pointer; transition: color 200ms ease,transform 200ms ease; }
.reveal-button:hover { color: var(--paper); }
.reveal-button:active { transform: scale(.94); }
.form-feedback { display: grid; grid-template-columns: 1fr auto; min-height: 36px; padding-top: 9px; }
.form-feedback p { margin: 0; font-size: 11px; }
.form-feedback > p:first-child { color: rgba(240,237,227,.32); }
.form-feedback a { color: rgba(240,237,227,.66); text-underline-offset: 3px; }
.key-error { color: #ef936e; text-align: right; }
.key-ready { color: rgba(240,237,227,.6); }
.enter-button { position: relative; display: flex; align-items: center; justify-content: space-between; width: 100%; height: 58px; margin-top: 6px; padding: 0 9px 0 21px; overflow: hidden; border: 0; background: var(--accent); color: #241813; font-size: 13px; font-weight: 680; cursor: pointer; box-shadow: inset 0 1px 0 rgba(255,255,255,.22),0 16px 42px rgba(0,0,0,.2); transition: background 220ms ease,opacity 220ms ease; }
.enter-button:hover:not(:disabled) { background: #e07850; }
.enter-button:disabled { background: rgba(255,255,255,.1); color: rgba(240,237,227,.3); cursor: not-allowed; box-shadow: inset 0 1px 0 rgba(255,255,255,.04); }
.enter-button__icon { display: grid; width: 40px; height: 40px; place-items: center; background: rgba(23,23,19,.14); }
.enter-button:disabled .enter-button__icon { background: rgba(255,255,255,.04); }
.button-scan { position: absolute; inset: 0; background: linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent); transform: translateX(-100%); animation: button-scan 1.35s ease-in-out infinite; }
.privacy-note { display: flex; align-items: center; gap: 9px; margin-top: 23px; color: rgba(240,237,227,.3); font-family: var(--font-mono),monospace; font-size: 8px; letter-spacing: .09em; text-transform: uppercase; }
.privacy-note svg { color: var(--accent); }
.privacy-note i { width: 2px; height: 2px; border-radius: 50%; background: currentColor; }
.gate-visual { display: grid; min-height: 600px; place-items: center; }
.gate-portrait { position: relative; display: grid; width: min(32vw,470px); aspect-ratio: 1; place-items: center; }
.gate-photo-wrap { position: relative; width: 63%; aspect-ratio: 1; overflow: hidden; border: 1px solid rgba(255,255,255,.14); border-radius: 50%; background: #cfcac2; box-shadow: inset 0 1px 0 rgba(255,255,255,.2),0 36px 90px rgba(0,0,0,.28); }
.gate-photo-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }
.gate-photo-wrap::after { position: absolute; inset: 0; content: ""; border-radius: inherit; box-shadow: inset 0 0 46px rgba(23,23,19,.38); }
.face-scan { position: absolute; right: 0; left: 0; height: 1px; background: var(--accent); animation: face-scan 3.2s cubic-bezier(.4,0,.2,1) infinite; }
.portrait-orbit { position: absolute; inset: 0; border: 1px solid rgba(255,255,255,.13); border-radius: 50%; animation: orbit-rotate 34s linear infinite; }
.portrait-orbit::before, .portrait-orbit::after { position: absolute; border: 1px dashed rgba(255,255,255,.07); border-radius: 50%; content: ""; }
.portrait-orbit::before { inset: 8%; }
.portrait-orbit::after { inset: 18%; border-style: solid; }
.portrait-dot { --angle: calc(var(--dot-index) * 25.714deg); position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,.15); transform: rotate(var(--angle)) translateX(calc(min(32vw,470px) / 2)) rotate(calc(var(--angle) * -1)); transition: background 280ms ease,box-shadow 280ms ease,scale 280ms ease; }
.portrait-dot--active { background: var(--accent); box-shadow: 0 0 0 5px rgba(216,105,62,.09); scale: 1.3; }
.gate-key-seal { position: absolute; right: 4%; bottom: 12%; display: grid; width: 72px; height: 72px; border: 1px solid rgba(255,255,255,.14); border-radius: 50%; place-items: center; background: rgba(23,23,19,.72); color: rgba(240,237,227,.55); box-shadow: inset 0 1px 0 rgba(255,255,255,.08); backdrop-filter: blur(12px); transition: color 300ms ease,border-color 300ms ease; }
.gate-key-seal span { position: absolute; top: 49px; font-family: var(--font-mono),monospace; font-size: 7px; letter-spacing: .15em; }
.gate-portrait--ready .gate-key-seal { border-color: rgba(216,105,62,.58); color: var(--accent); }
.gate-coordinate { position: absolute; color: rgba(240,237,227,.28); font-family: var(--font-mono),monospace; font-size: 8px; letter-spacing: .13em; }
.gate-coordinate--top { top: 8%; right: 4%; }
.gate-coordinate--bottom { bottom: 6%; left: 5%; }

.disconnect-link { display: flex; align-items: center; justify-self: end; gap: 8px; padding: 8px 0; border: 0; background: transparent; color: rgba(240,237,227,.48); font-size: 11px; cursor: pointer; transition: color 200ms ease,transform 200ms ease; }
.disconnect-link:hover { color: var(--paper); }
.disconnect-link:active { transform: translateY(1px); }
.room-layout { display: grid; grid-template-columns: minmax(310px,.8fr) minmax(500px,1.2fr); width: min(100% - 64px,1380px); min-height: calc(100dvh - 77px); margin: 0 auto; }
.conversation-panel { display: grid; grid-template-rows: auto minmax(0,1fr) auto; min-width: 0; max-height: calc(100dvh - 77px); padding: 34px 38px 32px 0; border-right: 1px solid var(--line); }
.panel-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
.panel-heading .eyebrow { margin: 0; }
.panel-heading > span { color: rgba(240,237,227,.32); font-family: var(--font-mono),monospace; font-size: 8px; }
.messages { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: rgba(240,237,227,.12) transparent; }
.empty-conversation { display: flex; min-height: 100%; padding: 12vh 0 70px; flex-direction: column; justify-content: center; }
.empty-conversation > span { margin-bottom: 19px; color: var(--accent); font-family: var(--font-mono),monospace; font-size: 8px; letter-spacing: .13em; }
.empty-conversation h2 { max-width: 350px; margin: 0; font-size: clamp(31px,3vw,47px); font-weight: 530; letter-spacing: -.058em; line-height: 1; }
.empty-conversation p { max-width: 37ch; margin: 18px 0 0; color: rgba(240,237,227,.43); font-size: 12px; line-height: 1.65; }
.message { padding: 21px 0 23px; border-bottom: 1px solid var(--line); }
.message-meta { display: flex; justify-content: space-between; margin-bottom: 9px; color: rgba(240,237,227,.32); font-family: var(--font-mono),monospace; font-size: 8px; letter-spacing: .11em; }
.message--assistant .message-meta span:first-child { color: var(--accent); }
.message p { margin: 0; color: rgba(240,237,227,.82); font-size: 14px; line-height: 1.6; }
.message--user p { color: rgba(240,237,227,.53); }
.prompt-composer { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; height: 54px; margin-top: 20px; padding: 0 7px 0 15px; border: 1px solid var(--line); background: rgba(255,255,255,.035); box-shadow: inset 0 1px 0 rgba(255,255,255,.04); }
.prompt-composer:focus-within { border-color: rgba(240,237,227,.28); }
.prompt-composer input { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--paper); font-size: 12px; }
.prompt-composer input::placeholder { color: rgba(240,237,227,.28); }
.prompt-composer button { display: grid; width: 40px; height: 40px; padding: 0; border: 0; place-items: center; background: var(--accent); color: #271a14; cursor: pointer; transition: transform 180ms ease,opacity 180ms ease; }
.prompt-composer button:disabled { opacity: .17; cursor: not-allowed; }
.prompt-composer button:active:not(:disabled) { transform: translateY(1px) scale(.96); }
.avatar-stage { position: relative; display: grid; grid-template-rows: auto minmax(0,1fr) auto auto; min-width: 0; max-height: calc(100dvh - 77px); padding: 30px 0 27px 38px; overflow: hidden; }
.avatar-stage::before { position: absolute; inset: 8% 4% 11% 10%; pointer-events: none; border: 1px solid rgba(240,237,227,.055); border-radius: 50%; content: ""; }
.stage-topline, .avatar-footer { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.stage-topline > span:first-child { color: rgba(240,237,227,.36); font-family: var(--font-mono),monospace; font-size: 8px; letter-spacing: .13em; }
.activity-badge { display: flex; align-items: center; gap: 8px; color: rgba(240,237,227,.62); font-family: var(--font-mono),monospace; font-size: 8px; letter-spacing: .11em; }
.activity-badge i { width: 6px; height: 6px; border-radius: 50%; background: rgba(240,237,227,.28); }
.activity-badge--listening i, .activity-badge--speaking i { background: var(--accent); box-shadow: 0 0 0 5px rgba(216,105,62,.12); animation: status-breathe 1s ease-in-out infinite; }
.activity-badge--thinking i { background: #b9ad83; animation: status-breathe .7s ease-in-out infinite; }
.avatar-figure { position: relative; z-index: 1; align-self: center; justify-self: center; width: min(100%,438px); aspect-ratio: 1003 / 1568; overflow: hidden; border: 1px solid rgba(255,255,255,.15); background: #c8c2b9; box-shadow: 0 34px 85px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.15); }
.avatar-base { width: 100%; height: 100%; object-fit: cover; }
.mouth-window { --voice-level: 0; position: absolute; top: 47.96%; left: 42.57%; width: 14.96%; height: 5.74%; pointer-events: none; }
.mouth-frame { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; object-fit: fill; mask-image: radial-gradient(ellipse 72% 78% at 50% 50%,#000 58%,transparent 92%); -webkit-mask-image: radial-gradient(ellipse 72% 78% at 50% 50%,#000 58%,transparent 92%); }
.mouth-window[data-mouth="soft"] .mouth-frame--soft, .mouth-window[data-mouth="round"] .mouth-frame--round, .mouth-window[data-mouth="open"] .mouth-frame--open { opacity: 1; }
.avatar-vignette { position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 72px rgba(24,22,18,.16); }
.avatar-footer { padding-top: 16px; border-top: 1px solid var(--line); }
.avatar-identity { display: flex; flex-direction: column; gap: 3px; }
.avatar-identity strong { font-size: 12px; letter-spacing: .06em; }
.avatar-identity span { color: rgba(240,237,227,.38); font-family: var(--font-mono),monospace; font-size: 7px; letter-spacing: .12em; }
.voice-controls { display: flex; gap: 8px; }
.round-control { display: grid; width: 42px; height: 42px; padding: 0; border: 1px solid var(--line); place-items: center; background: rgba(255,255,255,.035); color: rgba(240,237,227,.65); cursor: pointer; transition: background 180ms ease,border-color 180ms ease,color 180ms ease,transform 180ms ease; }
.round-control:hover { color: var(--paper); background: rgba(255,255,255,.06); }
.round-control:active { transform: translateY(1px) scale(.97); }
.round-control--active { border-color: rgba(216,105,62,.52); color: var(--accent); }
.sync-note { position: relative; z-index: 2; display: flex; align-items: center; gap: 7px; margin: 14px 0 0; color: rgba(240,237,227,.3); font-size: 9px; }
.sync-note svg { color: var(--accent); }
.room-error { position: fixed; right: 24px; bottom: 24px; z-index: 6; display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: 12px; width: min(420px,calc(100% - 32px)); padding: 13px 14px; border: 1px solid rgba(216,105,62,.42); background: rgba(28,25,21,.96); color: var(--paper); box-shadow: 0 22px 60px rgba(0,0,0,.32); }
.room-error > svg { color: var(--accent); }
.room-error p { margin: 0; font-size: 11px; line-height: 1.45; }
.room-error button { display: grid; width: 30px; height: 30px; padding: 0; border: 0; place-items: center; background: transparent; color: rgba(240,237,227,.52); cursor: pointer; }
@keyframes status-breathe { 0%,100% { opacity:.45; transform:scale(.88); } 50% { opacity:1; transform:scale(1); } }
@keyframes face-scan { 0%,10% { top:11%; opacity:0; } 18% { opacity:.9; } 76% { opacity:.7; } 88%,100% { top:89%; opacity:0; } }
@keyframes orbit-rotate { to { transform:rotate(360deg); } }
@keyframes button-scan { 0% { transform:translateX(-100%); } 60%,100% { transform:translateX(100%); } }
@keyframes input-nudge { 0%,100% { transform:translateX(0); } 30% { transform:translateX(-5px); } 60% { transform:translateX(4px); } }
@media (max-width: 980px) {
  .gate-layout { grid-template-columns: minmax(0,1fr) minmax(370px,.8fr); }
  .gate-portrait { width:min(38vw,430px); }
  .portrait-dot { transform:rotate(var(--angle)) translateX(calc(min(38vw,430px) / 2)) rotate(calc(var(--angle) * -1)); }
  .room-layout { grid-template-columns:minmax(280px,.72fr) minmax(430px,1.28fr); }
}
@media (max-width: 760px) {
  body { overflow:auto; }
  .gate-shell, .room-shell { overflow:visible; }
  .gate-nav, .room-nav { width:calc(100% - 32px); padding:20px 0 16px; }
  .gate-nav .model-stamp, .room-model { display:none; }
  .gate-layout { grid-template-columns:1fr; width:calc(100% - 32px); min-height:auto; padding:46px 0 38px; }
  .gate-copy { padding:0; }
  .gate-copy h1 { font-size:clamp(43px,13.5vw,62px); }
  .gate-intro { font-size:13px; }
  .gate-visual { min-height:410px; margin-top:34px; }
  .gate-portrait { width:min(88vw,390px); }
  .portrait-dot { transform:rotate(var(--angle)) translateX(calc(min(88vw,390px) / 2)) rotate(calc(var(--angle) * -1)); }
  .privacy-note { flex-wrap:wrap; }
  .room-nav { grid-template-columns:1fr auto; }
  .room-layout { grid-template-columns:1fr; grid-template-areas:"avatar" "conversation"; width:100%; min-height:auto; }
  .avatar-stage { grid-area:avatar; min-height:760px; max-height:none; padding:24px 16px 26px; border-bottom:1px solid var(--line); }
  .avatar-figure { width:min(86vw,410px); }
  .conversation-panel { grid-area:conversation; min-height:620px; max-height:none; padding:30px 16px 24px; border-right:0; }
  .empty-conversation { padding:90px 0; }
  .room-error { right:16px; bottom:16px; }
}
@media (max-width: 420px) {
  .avatar-stage { min-height:680px; }
  .form-feedback { grid-template-columns:1fr; gap:5px; }
  .key-error { text-align:left; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; }
}
