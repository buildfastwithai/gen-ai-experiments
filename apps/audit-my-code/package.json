{
  "name": "audit-my-code",
  "private": true,
  "version": "1.0.0",
  "description": "Full AI Security Audit — paste code, find vulnerabilities",
  "author": "Avi Singh",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "exe": "vite build && electron-builder --win portable",
    "exe:installer": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.auditmycode.app",
    "productName": "AuditMyCode",
    "directories": {
      "output": "desktop-release-github"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AuditMyCode.exe"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
