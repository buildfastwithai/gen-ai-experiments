# Copy to .env and fill in the blanks:  cp .env.example .env
#
# Every variable this app reads is listed here.
# - Values shown are safe local defaults; commit-safe.
# - Empty values are secrets. Never commit a filled-in .env.

# --- Core -------------------------------------------------------------------

# Environment name. Affects logging verbosity and error detail.
# One of: development | test | production
NODE_ENV=development

# Port the HTTP server binds to.
PORT=3000

# --- Database ---------------------------------------------------------------

# Postgres connection string. This default matches the `db` service in
# docker-compose.yml, so it works as-is with `docker compose up -d`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# Connections held in the pool. Raise only if you see pool timeouts.
DATABASE_POOL_SIZE=10

# --- Cache ------------------------------------------------------------------

# Redis connection string. Matches the `redis` service in docker-compose.yml.
# Leave unset to run without caching (slower, but fine locally).
REDIS_URL=redis://localhost:6379

# --- Third-party services ---------------------------------------------------

# REQUIRED. Create a key at https://example.com/settings/api-keys
# Use a test-mode key locally — live keys move real money.
API_KEY=

# OPTIONAL. Error reporting. Leave empty to disable in local development.
SENTRY_DSN=

# --- Feature flags ----------------------------------------------------------

# Serve the /debug routes. Never enable in production.
ENABLE_DEBUG_ROUTES=true
